  "item": [
    {
      "name": "Create Post - Valid Data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function(){\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\n\r\nconst json = pm.response.json();\r\n\r\npm.test(\"Response contains id\", function(){\r\n    pm.expect(json).to.have.property(\"id\");\r\n\r\n});\r\npm.test(\"Title is correct\", function(){\r\n        pm.expect(json.title).to.eql(\"www\");\r\n});\r\npm.test(\"Body is correct\", function(){\r\n        pm.expect(json.body).to.eql(\"zzz\");\r\n});\r\npm.test(\"User ID is correct\", function(){\r\n        pm.expect(json.userId).to.eql(1);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"title\": \"hello\",\r\n    \"body\": \"zzz\",\r\n    \"userId\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
